<?xml version="1.0"?>
<sdf version="1.7">

<model name="table_set">

  <static>true</static>

  <link name="table_set_link">

    <!-- simple_restaurant.world에서 model://table_set으로 불러오는 테이블 세트. -->
    <!-- 테이블 1개와 의자 4개의 시각·충돌 형상을 하나의 고정 모델로 묶는다. -->
    <!-- ========================= -->
    <!-- 테이블 -->
    <!-- ========================= -->

    <collision name="table_collision">
      <pose>0 0 0.375 0 0 0</pose>

      <geometry>
        <box>
          <size>1.22 0.75 0.75</size>
        </box>
      </geometry>
    </collision>

    <visual name="table_visual">
      <pose>0 0 0.375 0 0 0</pose>

      <geometry>
        <box>
          <size>1.22 0.75 0.75</size>
        </box>
      </geometry>
    </visual>

    <!-- ========================= -->
    <!-- 의자 1 -->
    <!-- ========================= -->

    <collision name="chair1_collision">
      <pose>-0.30 0.90 0.2 0 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.2</radius>
          <length>0.45</length>
        </cylinder>
      </geometry>
    </collision>

    <visual name="chair1_visual">
      <pose>-0.30 0.90 0.2 0 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.2</radius>
          <length>0.45</length>
        </cylinder>
      </geometry>
    </visual>

    <!-- 의자 2 -->

    <collision name="chair2_collision">
      <pose>0.30 0.90 0.2 0 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.2</radius>
          <length>0.45</length>
        </cylinder>
      </geometry>
    </collision>

    <visual name="chair2_visual">
      <pose>0.30 0.90 0.2 0 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.2</radius>
          <length>0.45</length>
        </cylinder>
      </geometry>
    </visual>

    <!-- 의자 3 -->

    <collision name="chair3_collision">
      <pose>-0.30 -0.90 0.2 0 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.2</radius>
          <length>0.45</length>
        </cylinder>
      </geometry>
    </collision>

    <visual name="chair3_visual">
      <pose>-0.30 -0.90 0.2 0 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.2</radius>
          <length>0.45</length>
        </cylinder>
      </geometry>
    </visual>

    <!-- 의자 4 -->

    <collision name="chair4_collision">
      <pose>0.30 -0.90 0.2 0 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.2</radius>
          <length>0.45</length>
        </cylinder>
      </geometry>
    </collision>

    <visual name="chair4_visual">
      <pose>0.30 -0.90 0.2 0 0 0</pose>

      <geometry>
        <cylinder>
          <radius>0.2</radius>
          <length>0.45</length>
        </cylinder>
      </geometry>
    </visual>

  </link>

</model>
</sdf>
